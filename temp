# Đường dẫn lưu trữ repo local
LOCAL_STORAGE_PATH = "./cloned_repos"

# --- DEFINING PYDANTIC MODELS ---

class RepoRequest(BaseModel):
    """Model cho request clone/pull repo"""
    url: str = Field(..., description="Git URL của repository")
    branch: Optional[str] = Field("main", description="Branch cần checkout")

class CredentialRequest(BaseModel):
    """Model cho request xác thực"""
    id: str = Field(..., description="Provider ID của user")
    name: str = Field(..., description="Tên hiển thị của user")
    token: str = Field(..., description="Access token (Git/Provider)")

class FixRequestModel(BaseModel):
    """Model cho yêu cầu sửa lỗi (Heal Code)"""
    # repo_name có thể optional nếu truyền qua path, nhưng giữ ở đây để validate body nếu cần
    repo_name: Optional[str] = Field(None, description="Tên Repository (nếu khác path param)")
    trace_error: str = Field(..., description="Nội dung lỗi (Error Trace) cần sửa")
    priority: int = Field(1, ge=1, le=5, description="Độ ưu tiên (1=Cao nhất, 5=Thấp nhất)")
    metadata: Optional[Dict] = Field(default_factory=dict, description="Metadata bổ sung")

class FixResponseModel(BaseModel):
    """Model cho phản hồi từ API fix"""
    request_id: str
    status: str
    message: str
    result: Optional[Dict] = None
    error: Optional[str] = None
    started_at: Optional[str] = None
    completed_at: Optional[str] = None
    execution_time_ms: Optional[float] = None

# --- APP LIFECYCLE ---

@asynccontextmanager
async def lifespan(app: FastAPI):
    """Quản lý vòng đời ứng dụng"""
    global queue_manager, task_processor
    
    # Startup
    logger.info("Starting code fix service...")
    queue_manager = QueueManager(max_workers=4, max_queue_size=1000)
    task_processor = TaskProcessor()
    queue_manager.add_task_handler(task_processor.process_fix_request)
    await queue_manager.start()
    
    logger.info("Code fix service started successfully")
    
    yield
    
    # Shutdown
    logger.info("Shutting down code fix service...")
    if queue_manager:
        await queue_manager.stop()
    logger.info("Code fix service stopped")

def create_app() -> FastAPI:
    app = FastAPI(
        title="Code Fix Service",
        description="API for automated code fixing using AI",
        version="1.0.0",
        lifespan=lifespan
    )
    
    app.add_middleware(
        CORSMiddleware,
        allow_origins=["*"],
        allow_credentials=True,
        allow_methods=["*"],
        allow_headers=["*"],
    )
    return app

app = create_app()

